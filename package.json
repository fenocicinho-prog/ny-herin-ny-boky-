{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "type": "module",
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "keywords": [
    "1610422010"
  ],
  "repository": {
    "type": "git",
    "url": "projet marketbook"
  },
  "license": "ISC",
  "author": "feno cicinho",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "npx next dev --webpack",
    "stripe": "npx stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "start-all": "concurrently \"npm run dev\" \"npm run stripe\"",
    "build": "npx prisma generate && npx prisma db push && npx next build",
    "start": "npx next start",
    "lint": "npx eslint .",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@stripe/stripe-js": "^7.4.0",
    "@uploadthing/react": "^7.3.2",
    "bcryptjs": "^3.0.2",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "jose": "^6.0.11",
    "lucide-react": "^0.525.0",
    "next": "^16.2.9",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.60.0",
    "resend": "^6.18.1",
    "stripe": "^18.3.0",
    "uploadthing": "^7.7.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
