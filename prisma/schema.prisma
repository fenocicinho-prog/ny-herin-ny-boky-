datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  VENDOR
  ADMIN
}

enum BookCategory {
  Fiction
  NonFiction
  PoésieThéatre
  LivrespourlaJeunesse
  Référence
  Autre
}

enum OrderType {
  BUY
  BORROW
  BOOK
}

enum PaymentMethod {
  STRIPE
  MOBILE_MONEY
  MVOLA
  ON_SITE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RECEIVED
}

enum SubscriptionPlan {
  FREE
  TWENTY_BOOKS
  UNLIMITED
}

enum MvolaPaymentStatus {
  EN_ATTENTE_CLIENT
  EN_ATTENTE_VERIFICATION
  EN_ATTENTE_MATCH
  PAYE
  LIVRE
  TERMINE
  ERREUR_REF
  ORPHELINE
}

enum AuditAction {
  PAYMENT_INITIATED
  CLIENT_REF_SUBMITTED
  ADMIN_REF_RECEIVED
  PAYMENT_VERIFIED
  PAYMENT_CONFIRMED
  SELLER_NOTIFIED
  DELIVERY_CONFIRMED
  VENDOR_PAID
  FRAUD_DETECTED
}

enum SellerPlanType {
  COMMISSION
  ABONNEMENT
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
  EXPIRED
}

model Seller {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  plantype SellerPlanType @default(COMMISSION)
  isActive Boolean @default(false)
  mvolaNumber String? // <- AJOUTÉ ICI POUR MVOLA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  password             String
  firstName            String?
  lastName             String?
  phoneNumber          String?
  role                 String            @default("CLIENT")
  isAdmin              Boolean           @default(false)
  companyName          String?
  location             String?
  postalCode           String?
  reasonForJoining     String?
  bookTypesSought      String?
  sellerPlanType       String?           @default("COMMISSION")
  subscriptionPlan     SubscriptionPlan  @default(FREE)
  subscriptionActive   Boolean           @default(false)
  subscriptionStatus   SubscriptionStatus? @default(ACTIVE)
  subscriptionEndsAt   DateTime?
  stripeSessionId      String?           @unique
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  mvolaNumber          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  books                Book[]
  orders               Order[]           @relation("UserOrders")
  soldOrders           OrderItem[]
  sellerProfile        Seller?
}

model Book {
  id String @id @default(cuid())
  title String
  description String?
  buyPrice    Float?
  rentPrice   Float?
  condition   String       @default("GOOD")
  imageUrl    String?
  category    BookCategory
  vendorId    String
  vendor      User         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Order {
  id                  String          @id @default(cuid())
  type                String          // "BUY" ou "BORROW" ou "BOOK"
  paymentMethod       String          // "STRIPE", "MOBILE_MONEY", "MVOLA"
  paymentStatus       String          @default("PENDING")
  deliveryStatus      String          @default("PENDING")
  deliveryLocation    String?
  paidToVendor        Boolean         @default(false)
  amount              Float
  phoneNumber         String?
  stripeSessionId     String?
  mvolaFee            Float?
  mvolaStatus         String          @default("EN_ATTENTE_CLIENT")
  clientTrxRef        String          @unique
  adminTrxRef         String?
  platformFee         Float           @default(0)
  vendorPaymentAmount Float           @default(0)
  userId              String
  user                User            @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  bookId    String
  sellerId  String
  quantity  Int
  price     Float
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}
